              "minutes": 0,
              "success_criteria": "Geen multitask tijdens de timer."
            }
          ]
        },
        {
          "week_index": 2,
          "phase_id": "protect",
          "title": "Week 2 — Diepte verhogen",
          "objective": "Verleng waar het kan; noteer weerstand.",
