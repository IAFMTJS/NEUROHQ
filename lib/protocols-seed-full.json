                "easy": { "concrete": "3 dagen met 1 blok per dag", "minutes": 10 },
                "medium": { "concrete": "5 dagen zoals beschreven", "minutes": 15 },
                "hard": { "concrete": "5 dagen + telefoon in andere kamer", "minutes": 20 }
              }
            },
            {
              "id": "fb-w1-t2",
              "title": "Start-ritueel",
              "concrete": "Voor elk blok: 60 sec zelfde start (adem / zelfde track / zelfde plek).",
              "minutes": 5,
              "scaling": {
                "easy": { "concrete": "Alleen ochtendblok", "minutes": 3 },
                "medium": { "concrete": "Alle geplande blokken", "minutes": 5 },
                "hard": { "concrete": "Alle blokken + log of het gebeurde", "minutes": 8 }
              }
            },
            {
              "id": "fb-w1-t3",
              "title": "Eén taak per blok",
