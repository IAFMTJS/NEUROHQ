              "scaling": {
                "easy": { "concrete": "15 min + 1 regel plan", "minutes": 15 },
                "medium": { "concrete": "30 min zoals beschreven", "minutes": 30 },
                "hard": { "concrete": "45 min + accountability partner bericht", "minutes": 45 }
