              "id": "fb-w4-t2",
              "title": "Herhaal template",
              "concrete": "Kopieer week 1-kalendersjabloon naar volgende 4 weken (lege blokken).",
              "minutes": 15,
              "success_criteria": "Template staat in agenda."
