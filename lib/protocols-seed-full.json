              "scaling": {
                "easy": { "concrete": "1 blok +5 min", "minutes": 10 },
                "medium": { "concrete": "2 blokken +10", "minutes": 20 },
                "hard": { "concrete": "4 blokken +10 + reflectie", "minutes": 35 }
              }
            },
            {
              "id": "fb-w2-t2",
              "title": "Weerstand log",
              "concrete": "Na elk blok: 1 zin ‘waarom ik afdwaalde’ (of ‘niet’).",
