              "scaling": {
                "easy": { "concrete": "1 dag tellen", "minutes": 15 },
                "medium": { "concrete": "2 dagen", "minutes": 30 },
                "hard": { "concrete": "3 dagen + screenshot van notificatie-instellingen", "minutes": 45 }
